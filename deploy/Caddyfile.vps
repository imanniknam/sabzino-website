sabzinow.ir, www.sabzinow.ir {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3000

  @static path /_next/static/* /images/* /favicon.svg /3190155.txt
  header @static Cache-Control "public, max-age=31536000, immutable"

  @dynamic not path /_next/static/* /images/* /favicon.svg /3190155.txt
  header @dynamic Cache-Control "no-cache, no-store, must-revalidate"

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    -Server
  }
}
